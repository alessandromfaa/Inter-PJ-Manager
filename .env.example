# Leitura externa opcional. Use compose.inter.yml e credenciais exclusivas do ambiente.
ENABLE_BANK_READS=false
INTER_COMPANY_ID=
INTER_ACCOUNT_ID=
INTER_ACCOUNT_NUMBER=
INTER_CREDENTIALS_ROOT=
