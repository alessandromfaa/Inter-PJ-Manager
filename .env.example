APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8080
APP_ORIGIN=http://127.0.0.1:8080
APP_TIMEZONE=America/Fortaleza
BANK_PROVIDER=inter
INTER_ENV=mock
ENABLE_REAL_PAYMENTS=false
ENABLE_BANK_WRITES=false
ADMIN_EMAIL=admin@local.test
COMPANY_NAME="Empresa de demonstração"
